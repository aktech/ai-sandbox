# Minimal image for aisb-proxy. Multi-stage: build the static binary, copy
# into a distroless static base. No shell, no secrets in layers; the proxy
# reads its CA + secrets from stdin at runtime, never from the image.
# Both stages pinned by digest (multi-arch index). Digests from the registry
# APIs (registry-1.docker.io, gcr.io). Bump: scripts/pins.sh image <name:tag>
FROM golang:1.26.10-bookworm@sha256:5de7c99eb78ca5e515a4c340235d0955ec5964a5071c492c15503d7c267da473 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/aisb-proxy ./cmd/aisb-proxy

# gcr.io/distroless/static-debian12:nonroot, resolved 2026-11-09.
FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY --from=build /out/aisb-proxy /aisb-proxy
ENTRYPOINT ["/aisb-proxy"]
